{
  "name": "jobstrider",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI job pipeline for scanning, evaluating, and tailoring applications for early-career software roles.",
  "license": "MIT",
  "bin": {
    "jobstrider": "./autoflow.mjs",
    "job-ops": "./autoflow.mjs"
  },
  "files": [
    "*.mjs",
    "llm/",
    "src/",
    "templates/",
    "companies.json",
    "config.example.json",
    "cv.example.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node scripts/start-ui.mjs",
    "ui": "node scripts/start-ui.mjs",
    "ui:build": "npm --prefix frontend run build",
    "install:browsers": "npx playwright install chromium",
    "test": "node test/runner.mjs",
    "smoke": "node test/smoke.test.mjs",
    "evaluate": "node evaluate.mjs",
    "tracker": "node tracker.mjs",
    "scanner": "node scanner.mjs",
    "scan-eval": "node scan-evaluate.mjs",
    "retry-errors": "node scan-evaluate.mjs --retry-errors --mode=all",
    "resume": "node resume-builder.mjs",
    "setup": "node setup-wizard.mjs",
    "setup-check": "node setup-check.mjs",
    "interview": "node interview-prep.mjs",
    "autoflow": "node autoflow.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.50.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "user-agents": "^1.1.352"
  }
}
