{
  "name": "jobstrider",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI job pipeline for scanning, evaluating, and tailoring applications for early-career software roles.",
  "author": "JobStrider Team <contact@jobstrider.dev>",
  "license": "MIT",
  "bin": {
    "jobstrider": "./autoflow.mjs",
    "job-ops": "./autoflow.mjs"
  },
  "files": [
    "*.mjs",
    "llm/",
    "src/",
    "templates/",
    "companies.json",
    "config.example.json",
    "cv.example.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "desktop": "electron desktop/main.mjs",
    "desktop:build": "node scripts/build-protected.mjs",
    "desktop:build:raw": "npm run ui:build && electron-builder --win",
    "start": "node scripts/start-ui.mjs",
    "ui": "node scripts/start-ui.mjs",
    "ui:build": "npm --prefix frontend run build",
    "install:browsers": "npx playwright install chromium",
    "test": "node test/runner.mjs",
    "smoke": "node test/smoke.test.mjs",
    "evaluate": "node evaluate.mjs",
    "tracker": "node tracker.mjs",
    "scanner": "node scanner.mjs",
    "scan-eval": "node scan-evaluate.mjs",
    "retry-errors": "node scan-evaluate.mjs --retry-errors --mode=all",
    "resume": "node resume-builder.mjs",
    "setup": "node setup-wizard.mjs",
    "setup-check": "node setup-check.mjs",
    "interview": "node interview-prep.mjs",
    "autoflow": "node autoflow.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.65.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "user-agents": "^1.1.352"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^5.10.1"
  },
  "build": {
    "appId": "com.jobstrider.desktop",
    "productName": "JobStrider",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      {
        "from": ".desktop-staging",
        "to": "."
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
